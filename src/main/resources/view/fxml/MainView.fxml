<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.github.specdock.videoframeinterpolator.view.controller.MainController"
            prefWidth="900" prefHeight="650" stylesheets="@style.css">

    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <left>
        <VBox spacing="15" prefWidth="250" styleClass="card">
            <BorderPane.margin><Insets right="25"/></BorderPane.margin>

            <Label text="等待中" styleClass="title-label"/>
            <ListView fx:id="waitingListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="CENTER" spacing="30">
            <VBox alignment="CENTER" spacing="15" styleClass="card" prefWidth="320" maxHeight="160">
                <Label fx:id="currentTaskLabel" text="无任务 处理中" styleClass="title-label"/>
                <ProgressBar fx:id="taskProgressBar" progress="0.0" prefWidth="260" prefHeight="18"/>
                <Label fx:id="progressLabel" text="0 / 0 帧" textFill="#64748b"/>
            </VBox>

            <HBox alignment="CENTER" spacing="15" styleClass="card" prefWidth="280" maxHeight="60">
                <Label text="成品地址" styleClass="title-label" textFill="#475569" minWidth="-Infinity"/>

                <Button fx:id="copyOutputDirBtn" text="复制路径" onAction="#handleCopyOutputDir" minWidth="-Infinity"
                        style="-fx-background-color: #EFF6FF; -fx-text-fill: #3B82F6; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 6 14; -fx-font-size: 12px; -fx-font-weight: bold;"/>
            </HBox>

            <Button text="添加视频" onAction="#handleAddVideo" styleClass="button-primary" style="-fx-padding: 12 40;"/>

            <Button fx:id="toggleProcessBtn" text="▶ 启动" onAction="#handleToggleProcess"
                    styleClass="circle-button" style="-fx-min-width: 110px; -fx-min-height: 110px; -fx-font-size: 18px;"/>
        </VBox>
    </center>

    <right>
        <VBox spacing="15" prefWidth="250" styleClass="card">
            <BorderPane.margin><Insets left="25"/></BorderPane.margin>

            <Label text="已完成" styleClass="title-label"/>
            <ListView fx:id="completedListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </right>
</BorderPane>