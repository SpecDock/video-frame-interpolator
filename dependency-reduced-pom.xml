<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.github.specdock</groupId>
  <artifactId>video-frame-interpolator</artifactId>
  <version>1.1-release</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer />
                <transformer>
                  <mainClass>com.github.specdock.videoframeinterpolator.view.Application</mainClass>
                </transformer>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>create-executable</id>
            <phase>install</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/jpackage</executable>
              <workingDirectory>${project.basedir}</workingDirectory>
              <arguments>
                <argument>--type</argument>
                <argument>app-image</argument>
                <argument>--name</argument>
                <argument>${project.artifactId}</argument>
                <argument>--input</argument>
                <argument>${project.build.directory}</argument>
                <argument>--main-jar</argument>
                <argument>${project.build.finalName}.jar</argument>
                <argument>--main-class</argument>
                <argument>com.github.specdock.videoframeinterpolator.view.Application</argument>
                <argument>--dest</argument>
                <argument>${project.build.directory}/native-image</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <javacpp.windows.ffmpeg.classifier>windows-x86_64-gpl</javacpp.windows.ffmpeg.classifier>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.2</javafx.version>
    <javacpp.openblas.version>0.3.28-1.5.11</javacpp.openblas.version>
    <javacpp.ffmpeg.version>7.1-1.5.11</javacpp.ffmpeg.version>
    <javacv.version>1.5.11</javacv.version>
    <javacpp.opencv.version>4.10.0-1.5.11</javacpp.opencv.version>
  </properties>
</project>
